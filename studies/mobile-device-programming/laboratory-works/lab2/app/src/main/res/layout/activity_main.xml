<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/primary_blue"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_subtitle"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DISPLAY CARD (HIGH CONTRAST) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- EXPRESSION FIELD -->
                <EditText
                    android:id="@+id/tvExpression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/hint_expression"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:textAlignment="textEnd"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor,TextFields" />

                <!-- RESULT FIELD -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/result_placeholder"
                    android:textAlignment="textEnd"
                    android:textColor="@color/primary_blue"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CALCULATOR KEYPAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROW 1: C, ( ), ^, ÷ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_clear"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:backgroundTint="@color/accent_red"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnParentheses"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_parentheses"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="18sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPower"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_power"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDivide"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_divide"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ROW 2: 7, 8, 9, × -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn7"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="7"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn8"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="8"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn9"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="9"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMultiply"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_multiply"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ROW 3: 4, 5, 6, − -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn4"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="4"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn5"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="5"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn6"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="6"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubtract"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_subtract"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ROW 4: 1, 2, 3, + -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn1"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="1"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn2"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="2"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn3"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="3"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_add"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ROW 5: ±, 0, ., = -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlusMinus"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_plus_minus"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn0"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="0"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDot"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="."
                    android:textColor="@color/btn_digit_text"
                    android:textSize="22sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEquals"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_equals"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:backgroundTint="@color/accent_green"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ROW 6: ⌫, %, Вихід -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackspace"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_backspace"
                    android:textColor="@color/accent_orange"
                    android:textSize="20sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMod"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:text="@string/btn_mod"
                    android:textColor="@color/btn_digit_text"
                    android:textSize="18sp"
                    app:backgroundTint="@color/btn_digit_bg"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExit"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_margin="3dp"
                    android:layout_weight="2"
                    android:text="@string/btn_exit"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="#475569"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
