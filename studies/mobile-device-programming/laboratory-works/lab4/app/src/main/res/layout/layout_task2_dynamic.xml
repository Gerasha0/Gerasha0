<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Section Title -->
    <TextView
        android:id="@+id/tvTask2Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task2_title"
        android:textColor="?attr/colorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMoveComponent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/task2_btn_move"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnResetComponent"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/task2_btn_reset"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvTask2Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#EFEFEF"
        android:padding="8dp"
        android:text="@string/task2_status_initial"
        android:textColor="#333333"
        android:textSize="13sp" />

    <!-- RelativeLayout Container where dynamic view manipulation happens -->
    <RelativeLayout
        android:id="@+id/relativeContainerTask2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:background="#FAFAFA"
        android:padding="16dp">

        <!-- Top Anchor View -->
        <TextView
            android:id="@+id/tvTopAnchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="#D1C4E9"
            android:padding="12dp"
            android:text="@string/task2_anchor_top"
            android:textColor="#311B92"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Bottom Anchor View (Placed below top anchor, independent of cardMovable) -->
        <TextView
            android:id="@+id/tvBottomAnchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTopAnchor"
            android:layout_marginTop="140dp"
            android:background="#C8E6C9"
            android:padding="12dp"
            android:text="@string/task2_anchor_bottom"
            android:textColor="#1B5E20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Movable View (Initially placed below Top Anchor) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMovable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTopAnchor"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFE082"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvMovableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/task2_movable"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>
</LinearLayout>
