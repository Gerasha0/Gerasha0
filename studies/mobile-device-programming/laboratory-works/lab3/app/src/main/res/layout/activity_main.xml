<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gray_bg"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Головна вертикальна розмітка LinearLayout -->
        <LinearLayout
            android:id="@+id/mainLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Блок 1: Заголовок лабораторної роботи -->
            <TextView
                android:id="@+id/tvLabTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lab_topic"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <!-- Блок 2: Вкладений Горизонтальний LinearLayout -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/linear_horizontal_title"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#555555"
                android:layout_gravity="start"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/horizontalLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="@string/app_name"
                    android:textColor="@color/teal_700"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStr1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="@string/str1"
                    android:textColor="@color/purple_700"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Блок 3: Вкладений Вертикальний LinearLayout -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/linear_vertical_title"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#555555"
                android:layout_gravity="start"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/nestedVerticalLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvStr2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str2"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/linear_vertical_desc"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Блок 4: Демонстрація FrameLayout (Накладання елементів) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/frame_title"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#555555"
                android:layout_gravity="start"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_overlay"
                android:textSize="13sp"
                android:textColor="@color/teal_700"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- FrameLayout Container -->
            <FrameLayout
                android:id="@+id/demoFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:contentDescription="@string/cd_demo_image" />

                <TextView
                    android:id="@+id/tvFrameOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/overlay_text_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/frame_text"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Контейнер для переключеного режиму (LinearLayout) -->
            <LinearLayout
                android:id="@+id/demoLinearLayoutContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvLinearText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/frame_text"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/imgViewLinear"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:contentDescription="@string/cd_demo_image" />
            </LinearLayout>

            <!-- Кнопка для переключення режимів наочності -->
            <Button
                android:id="@+id/btnToggleLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_toggle_layout"
                android:backgroundTint="@color/purple_500"
                android:textColor="@color/white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>