<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme -->
    <style name="Theme.Lab1Resources" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <!-- Task 1: Style for displaying surname in text view -->
    <style name="SurnameTextStyle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/surname_text_color</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
